# Mezvuat AI: environment variable NAMES only. Copy to .env and fill locally. Never commit .env.

# Core
MEZVUAT_ENV=
MEZVUAT_LOG_LEVEL=
MEZVUAT_API_KEY=
MEZVUAT_SECRET_KEY=
MEZVUAT_USER_HASH_SECRET=
MEZVUAT_DATA_DIR=
MEZVUAT_CORPUS_MANIFEST=

# PostgreSQL
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Qdrant
QDRANT_URL=
QDRANT_API_KEY=

# Models / ML
HF_HOME=
HF_TOKEN=
EMBEDDING_MODEL_ID=
RERANKER_MODEL_ID=
ML_DEVICE=
INDEX_VERSION=

# Claim verification (ADR-0009, 2026-11-16 amendment). NLI runs on CPU by default; the LLM judge is off until calibrated.
NLI_ENABLED=
NLI_MODEL_ID=
NLI_DEVICE=
NLI_THRESHOLDS_FILE=
VERIFY_LLM_JUDGE=
VERIFY_MAX_JUDGE_CALLS=

# Inference layer (ADR-0011): direct | modelmesh | modelmesh_with_fallback
INFERENCE_MODE=

# ModelMesh (optional; M8). Base URL without /v1. Unset means nothing ever talks to ModelMesh.
# ModelMesh modes also need MEZVUAT_SECRET_KEY (it derives the per-workspace cache namespace).
MODELMESH_BASE_URL=
MODELMESH_API_KEY=
MODELMESH_TIMEOUT_S=
MODELMESH_CONTRACT_TTL_S=
MODELMESH_CALIBRATION_TTL_S=
MODELMESH_BREAKER_FAILURES=
MODELMESH_BREAKER_OPEN_S=
# JSON, e.g. {"evidence_synthesis": 0.7}; sent only for task types ModelMesh reports as calibrated
MODELMESH_MIN_QUALITY=

# Direct-provider fallback: Groq
GROQ_API_KEY=
GROQ_BASE_URL=
GROQ_MODEL_SMALL=
GROQ_MODEL_LARGE=

# Direct local backend: Ollama (decision D1: the only backend allowed for private workspaces)
OLLAMA_BASE_URL=
OLLAMA_MODEL=
OLLAMA_MODEL_LARGE=
# groq | ollama: which direct backend serves public-corpus workspaces
DIRECT_PUBLIC_BACKEND=

# Research runs (ADR-0008 bounds)
RUN_DEADLINE_S=
RUN_MAX_LLM_CALLS=
RUN_MAX_TOKENS=
RUN_CONCURRENCY=
# postgres | memory
RUN_CHECKPOINTER=

# Evaluation judge (ADR-0012)
EVAL_JUDGE_BACKEND=
EVAL_JUDGE_MODEL=

# Observability (optional)
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_CAPTURE_CONTENT=
MLFLOW_TRACKING_URI=

# Frontend (M7): where the Next.js /api/v1 proxy sends requests; it also forwards MEZVUAT_API_KEY.
# Default http://127.0.0.1:18000 (the compose api port). Compose sets http://api:8000 itself.
MEZVUAT_API_URL=

# Optional services
GROBID_URL=
