# Mezvuat AI: environment variable NAMES only. Copy to .env and fill locally. Never commit .env.

# Core
MEZVUAT_ENV=
MEZVUAT_LOG_LEVEL=
MEZVUAT_SECRET_KEY=
MEZVUAT_USER_HASH_SECRET=
MEZVUAT_DATA_DIR=

# PostgreSQL
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Qdrant
QDRANT_URL=
QDRANT_API_KEY=

# Models / ML
HF_HOME=
HF_TOKEN=
EMBEDDING_MODEL_ID=
EMBEDDING_MODEL_REVISION=
RERANKER_MODEL_ID=
RERANKER_MODEL_REVISION=
ML_DEVICE=

# Inference layer (ADR-0011): direct | modelmesh | modelmesh_with_fallback
INFERENCE_MODE=

# ModelMesh (optional)
MODELMESH_BASE_URL=
MODELMESH_API_KEY=
MODELMESH_TIMEOUT_S=

# Direct-provider fallback: Groq
GROQ_API_KEY=
GROQ_BASE_URL=
GROQ_MODEL_SMALL=
GROQ_MODEL_LARGE=

# Evaluation judge (ADR-0012)
EVAL_JUDGE_BACKEND=
EVAL_JUDGE_MODEL=

# Observability (optional)
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_CAPTURE_CONTENT=
MLFLOW_TRACKING_URI=

# Optional services
GROBID_URL=
